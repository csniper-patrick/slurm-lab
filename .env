# Execution mode: prod (default), dev, ci
# Can be selected via MODE=dev or MODE=ci, or by running make dev / make ci
# MODE=prod

# image settings
# Specify full image name with tag
# IMAGE=registry.gitlab.com/csniper/slurm-lab/slurm-lab:d45fbf7a-deb12-26.05
# Or specify tag only, image name will be constructed as docker.io/csniper/slurm-lab:${TAG}
# TAG=deb12

# Optional overrides:
# COMPOSE_PROFILES=lyoko  # activate lyoko second cluster
# COMPUTE_REPLICAS=4      # number of compute node replicas
# SERVICE_CONDITION=service_healthy
# DISABLE_HEALTHCHECK=false

# Fix project, Do not change
COMPOSE_PROJECT_NAME=slurm-lab

# MySQL variables
MYSQL_PASSWORD=password
MYSQL_USER=slurm
MYSQL_DATABASE=slurm_acct_db
MYSQL_RANDOM_ROOT_PASSWORD=yes

# choose authentication plugin, allowed value: auth/munge (default), auth/slurm
# AUTHTYPE=auth/slurm

# PrivateData variable for slurm accounting db
# SLURMDB_PRIVATEDATA=

# PrivateData variable for slurm
# SLURM_PRIVATEDATA=

# Uncomment to use jyputer_moss spawner, jupyter lab session will ba launched from a slurm job
# JUPYTER_SPAWNER=moss